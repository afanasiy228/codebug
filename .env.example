# Telegram Admin Bot. Never commit the real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALERT_CHAT_IDS=
TELEGRAM_MONITOR_ENABLED=1
TELEGRAM_MONITOR_INTERVAL=60
TELEGRAM_QUEUE_WARNING=25
TELEGRAM_DISK_FREE_WARNING_PERCENT=10
TELEGRAM_ALERT_COOLDOWN=900

# Optional backup heartbeat written by the backup job.
BACKUP_HEARTBEAT_FILE=
BACKUP_MAX_AGE_SECONDS=93600

# External watcher settings.
CODEBUG_HEALTH_URL=https://codebug.onrender.com/ping
UPTIME_INTERVAL=60
UPTIME_TIMEOUT=10
UPTIME_FAILURE_THRESHOLD=2
SSL_WARNING_DAYS=14
UPTIME_STATE_FILE=/tmp/codebug-uptime-state.json
